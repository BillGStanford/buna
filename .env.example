NEXT_PUBLIC_SUPABASE_URL=https://qcmgfjovubnnjcejnvvd.supabase.co
# The anon / publishable key. Safe for the browser; protected by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjbWdmam92dWJubmpjZWpudnZkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI5NDU2OTgsImV4cCI6MjEwODUyMTY5OH0.2HyAZj9EXHIEksihftyS0T9GWkwiLhQQJoJdtKVxqU0
# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_, never log, never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjbWdmam92dWJubmpjZWpudnZkIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5Mjk0NTY5OCwiZXhwIjoyMTA4NTIxNjk4fQ.0Z2DDict0Km9QE8c5eF4NSO97ecEe8h31fijaOb_5gw

# --- Site ---
# Public origin of the site (no trailing slash). Used in email links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email sent by the app: inquiries, invitations, moderation) ---
# Optional until phase 3/4 features are used. Without both values the app records the event and
# marks email delivery "not_configured" instead of pretending it was sent.
RESEND_API_KEY=
EMAIL_FROM=Buna <hello@your-verified-domain.com>

# --- Scheduled jobs (GET /api/cron/daily: publish scheduled launches, retry emails, prune rate limits) ---
# At least 16 random characters. Vercel sends it as `Authorization: Bearer <secret>`; the route refuses every call without it.
CRON_SECRET=

# --- Operator details shown in the legal pages and contact page ---
# Name of the person/company that operates the site (appears in the Terms and Privacy Policy). Set this before launch.
NEXT_PUBLIC_OPERATOR_NAME=
# Where contact-form messages are also emailed (optional; they're always stored in /admin/messages).
SUPPORT_EMAIL=
